# Mirrors docker-compose.test.yml. Copy to .env.test for running integration tests.

DATABASE_URL="postgresql://inbody:inbody@localhost:5433/inbody_test?schema=public"

JWT_SECRET="test-secret-please-min-32-characters-long"

S3_ENDPOINT="http://localhost:9100"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="inbody-test"

MAX_UPLOAD_BYTES="10485760"
