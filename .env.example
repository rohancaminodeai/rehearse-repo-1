# Mirrors docker-compose.yml exactly (CLAUDE.md rule 15). Copy to .env for local dev.

# --- Database (postgres service) ---
DATABASE_URL="postgresql://inbody:inbody@localhost:5432/inbody?schema=public"

# --- Auth ---
# Must be at least 32 characters. Generate a real one for any shared environment.
JWT_SECRET="dev-secret-change-me-please-min-32-characters"

# --- Object storage (minio service) ---
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="inbody"

# --- Uploads ---
MAX_UPLOAD_BYTES="10485760"
